inicio
    AbrirConsole()
   
	enquanto(verdadeiro) farei {
        numero distanciaD = Ultra("sensorUD")
        numero distanciaE = Ultra("sensorUE")
        EscreverLinha(Cor("sensorD"))
        EscreverLinha(Cor("sensorDD"))
        EscreverLinha(Cor("sensorE"))
        EscreverLinha(Cor("sensorEE"))
		Esperar(1)
		se(Cor("sensorD") == "Preto" ou Cor("sensorDD") == "Preto") entao {
			DIREITA(200)
		} senao se(Cor("sensorE") == "Preto" ou Cor("sensorEE") == "Preto") entao {
			ESQUERDA(200)
		} senao se(Cor("sensorD") == "Verde" ou Cor("sensorDD") == "Verde") entao {
			DIREITA(200)
            Esperar(1000)
        } senao se(Cor("sensorE") == "Verde" ou Cor("sensorEE") == "Verde") entao {
            ESQUERDA(200)
            Esperar(1000)
        } senao se(TemAlgo("sensorUD") e TemAlgo("sensorUE")) entao {
            FRENTE(200)
            BUSCA(100)
            Esperar(1000)
        } senao se(distanciaD < 30 e distanciaE < 30) entao {
            # Se ambos os sensores ultrassônicos detectarem algo
            FRENTE(200)
            BUSCA(100)
            Esperar(1000)
        } senao {
			FRENTE(200)
        }
          
}
fim